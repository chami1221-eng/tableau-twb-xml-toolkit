            <groupfilter function='level-members' level='[none:データの種類:nk]' />
          </filter>
          <filter class='categorical' column='[federated.ds_d2].[none:分野:nk]'>
            <groupfilter function='level-members' level='[none:分野:nk]' />
          </filter>
          <filter class='categorical' column='[federated.ds_d2].[none:地域:nk]'>
            <groupfilter function='level-members' level='[none:地域:nk]' />
          </filter>
          <filter class='categorical' column='[federated.ds_d2].[none:年月:nk]'>
            <groupfilter function='level-members' level='[none:年月:nk]' />
          </filter>
          <slices>
            <column>[federated.ds_d2].[none:データの種類:nk]</column>
            <column>[federated.ds_d2].[none:分野:nk]</column>
            <column>[federated.ds_d2].[none:地域:nk]</column>
            <column>[federated.ds_d2].[none:年月:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <!-- 座標は見せない。軸ヘッダを消すのは attr='display' value='false'
                 （Tier A 131件。tick-visibility は自作の造語だったので使わない） -->
            <format attr='display' class='0' field='[federated.ds_d2].[avg:座標X:qk]' scope='cols' value='false' />
            <format attr='display' class='1' field='[federated.ds_d2].[avg:座標X:qk]' scope='cols' value='false' />
            <format attr='display' class='0' field='[federated.ds_d2].[avg:座標Y:qk]' scope='rows' value='false' />
            <format attr='display' class='1' field='[federated.ds_d2].[avg:座標Y:qk]' scope='rows' value='false' />
            <format attr='display' class='0' field='[federated.ds_d2].[avg:座標Y2:qk]' scope='rows' value='false' />
            <format attr='display' class='1' field='[federated.ds_d2].[avg:座標Y2:qk]' scope='rows' value='false' />
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
          <style-rule element='mark'>
            <!-- 丸の大きさの範囲。max/min（データ範囲）は書かない＝フィルターで件数が
                 減ったとき固定値だと全部小さくなるので、現在の表示範囲に自動追従させる -->
            <encoding attr='size' field='[federated.ds_d2].[sum:語の出現件数:qk]' field-type='quantitative'
                      max-size='1' min-size='0.10' type='quantsize' />
          </style-rule>
          <style-rule element='axis'>
            <!-- ★二重軸（線レイヤ＋丸レイヤを重ねる）。fold='true' が本体
                 → feedback_twb_dual_axis_xml.md
              ★★2軸のレンジを **両方とも固定** しないと、丸が線より下にずれて別の絵になる
                （260916 実測）。座標は生成時に 0〜100 へ正規化済みで、フィルターしても
                値域が変わらないので固定してよい（共起回数のような集計値とはここが違う）。 -->
            <encoding attr='space' class='0' field='[federated.ds_d2].[avg:座標Y:qk]' field-type='quantitative' max='104' min='-4' range-type='fixed' scope='rows' type='space' />
            <encoding attr='space' class='0' field='[federated.ds_d2].[avg:座標Y2:qk]' field-type='quantitative' fold='true' max='104' min='-4' range-type='fixed' scope='rows' type='space' />
            <encoding attr='space' class='0' field='[federated.ds_d2].[avg:座標X:qk]' field-type='quantitative' max='104' min='-4' range-type='fixed' scope='cols' type='space' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
          <!-- ① 線レイヤ。細く一定。関係があることだけを示す -->
          <pane id='1' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.ds_d2].[avg:座標Y:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.ds_d2].[none:分野:nk]' />
              <lod column='[federated.ds_d2].[none:エッジID:nk]' />
              <path column='[federated.ds_d2].[none:順序:ok]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='0.32' />
                <format attr='mark-labels-show' value='false' />
              </style-rule>
            </style>
          </pane>
          <!-- ② 丸レイヤ。大きさ＝その語が出てきた件数。ラベルは1ノード1箇所 -->
          <pane id='2' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.ds_d2].[avg:座標Y2:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <size column='[federated.ds_d2].[sum:語の出現件数:qk]' />
              <color column='[federated.ds_d2].[none:分野:nk]' />
              <!-- ★260916 修正: lod は エッジID ではなく キーワード。
                   エッジID だと **1マーク＝1エッジ（両端の2語）** になり、「ノードを押した」
                   ことにならない＝押した語が一意に決まらない。座標はキーワードごとに一意
                   （実データで検査済み・0件の重複）なので、キーワードでまとめて1語1丸になる。
                   path（順序）も丸には不要なので外す（線レイヤにだけ残す）。 -->
              <lod column='[federated.ds_d2].[none:キーワード:nk]' />
              <text column='[federated.ds_d2].[min:ラベル語:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='0.9' />
                <format attr='mark-labels-show' value='true' />
                <!-- ★cull='true' にすると、丸が集中するハブの語が重なり判定で丸ごと消える。
                     ラベルは既にデータ側で1ノード1回に絞ってあるので、ここは消さない -->
                <format attr='mark-labels-cull' value='false' />
                <format attr='mark-labels-mode' value='all' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.ds_d2].[avg:座標Y:qk] + [federated.ds_d2].[avg:座標Y2:qk])</rows>
        <cols>[federated.ds_d2].[avg:座標X:qk]</cols>
      </table>
      <simple-id uuid='{46B4C6D1-6107-4DF6-9511-2AC4C07C6B71}' />
