  <worksheet name='BAN_歳入合計'>
    <table>
      <view>
        <datasources>
          <datasource caption='予算データ（サンプル）' name='federated.ds_budget' />
        </datasources>
        <datasource-dependencies datasource='federated.ds_budget'>
          <column caption='&quot; &quot;' datatype='string' name='[calc_spacer]' role='dimension' type='nominal'>
            <calculation class='tableau' formula='&quot; &quot;' />
          </column>
          <column caption='MIN(0.0)' datatype='real' name='[calc_min0]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='MIN(0.0)' />
          </column>
          <column caption='MIN(1.0)' datatype='real' name='[calc_min1]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='MIN(1.0)' />
          </column>
          <column caption='歳入合計' datatype='real' name='[calc_sainyuu_total]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='SUM(IF [区分1] = &quot;歳入予算&quot; AND [区分4] != &quot;&quot; THEN [金額] END) / 100000000' />
          </column>
          <column-instance column='[calc_spacer]' derivation='None' name='[none:calc_spacer:nk]' pivot='key' type='nominal' />
          <column-instance column='[calc_min0]' derivation='User' name='[usr:calc_min0:qk]' pivot='key' type='quantitative' />
          <column-instance column='[calc_min1]' derivation='User' name='[usr:calc_min1:qk]' pivot='key' type='quantitative' />
          <column-instance column='[calc_sainyuu_total]' derivation='User' name='[usr:calc_sainyuu_total:qk]' pivot='key' type='quantitative' />
        </datasource-dependencies>
        <filter class='categorical' column='[federated.ds_budget].[none:年度:nk]'>
          <groupfilter function='member' level='[none:年度:nk]' member='&quot;令和７年度&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='filter-simple' />
        </filter>
      </view>
      <panes>
        <pane selection-relaxation-option='selection-relaxation-disallow'
              x-axis-name='[federated.ds_budget].[usr:calc_min0:qk]'>
          <mark class='Bar' />
          <mark-sizing mark-sizing-setting='marks-scaling-off' />
          <customized-label>
            <formatted-text>
              <run fontcolor='#4f4a41' fontname='Tableau Light' fontsize='13'>歳入合計（億円）</run>
            </formatted-text>
          </customized-label>
          <style>
            <style-rule element='cell'>
              <format attr='text-align' value='left' />
            </style-rule>
            <style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='mark-labels-cull' value='false' />
              <format attr='has-stroke' value='false' />
              <format attr='mark-color' value='#ffffff' />
              <format attr='mark-transparency' value='0' />
            </style-rule>
          </style>
        </pane>
        <pane id='1' selection-relaxation-option='selection-relaxation-disallow'
              x-axis-name='[federated.ds_budget].[usr:calc_min1:qk]'>
          <mark class='GanttBar' />
          <mark-sizing mark-sizing-setting='marks-scaling-off' />
          <encodings>
            <text column='[federated.ds_budget].[usr:calc_sainyuu_total:qk]' />
          </encodings>
          <customized-label>
            <formatted-text>
              <run fontname='Tableau Light' fontsize='20'>&lt;[federated.ds_budget].[usr:calc_sainyuu_total:qk]&gt;</run>
            </formatted-text>
          </customized-label>
          <style>
            <style-rule element='cell'>
              <format attr='text-align' value='right' />
            </style-rule>
            <style-rule element='datalabel'>
              <format attr='color-mode' value='user' />
              <format attr='color' value='#4f4a41' />
            </style-rule>
            <style-rule element='mark'>
              <format attr='mark-labels-show' value='true' />
              <format attr='has-stroke' value='false' />
              <format attr='mark-color' value='#ffffff' />
              <format attr='mark-transparency' value='0' />
            </style-rule>
          </style>
        </pane>
      </panes>
      <rows>[federated.ds_budget].[none:calc_spacer:nk]</rows>
      <cols>([federated.ds_budget].[usr:calc_min0:qk] + [federated.ds_budget].[usr:calc_min1:qk])</cols>
    </table>
    <style />
