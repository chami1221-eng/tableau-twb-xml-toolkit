  <worksheets>
    <worksheet name='円グラフ_歳入構成'>
      <table>
        <view>
          <datasources>
            <datasource caption='予算データ（サンプル）' name='federated.ds_budget' />
          </datasources>
          <datasource-dependencies datasource='federated.ds_budget'>
            <column caption='年度' datatype='string' name='[年度]' role='dimension' type='nominal' />
            <column caption='区分1' datatype='string' name='[区分1]' role='dimension' type='nominal' />
            <column caption='区分4' datatype='string' name='[区分4]' role='dimension' type='nominal' />
            <column caption='金額' datatype='integer' name='[金額]' role='measure' type='quantitative' />
            <column-instance column='[年度]' derivation='None' name='[none:年度:nk]' pivot='key' type='nominal' />
            <column-instance column='[区分1]' derivation='None' name='[none:区分1:nk]' pivot='key' type='nominal' />
            <column-instance column='[区分4]' derivation='None' name='[none:区分4:nk]' pivot='key' type='nominal' />
            <column-instance column='[金額]' derivation='Sum' name='[sum:金額:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.ds_budget].[none:年度:nk]'>
            <groupfilter function='member' level='[none:年度:nk]' member='&quot;令和７年度&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='filter-simple' />
          </filter>
          <filter class='categorical' column='[federated.ds_budget].[none:区分1:nk]'>
            <groupfilter function='member' level='[none:区分1:nk]' member='&quot;歳入予算&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='filter-simple' />
          </filter>
          <filter class='categorical' column='[federated.ds_budget].[none:区分4:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='filter-simple'>
              <groupfilter function='level-members' level='[none:区分4:nk]' />
              <groupfilter function='member' level='[none:区分4:nk]' member='&quot;&quot;' />
            </groupfilter>
          </filter>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Pie' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <color column='[federated.ds_budget].[none:区分4:nk]' />
              <wedge-size column='[federated.ds_budget].[sum:金額:qk]' />
              <text column='[federated.ds_budget].[none:区分4:nk]' />
              <text column='[federated.ds_budget].[sum:金額:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{8E92194D-586E-4134-96A3-B3CEBB612CBB}' />
    </worksheet>
