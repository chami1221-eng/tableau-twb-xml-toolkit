      <column caption='区分5' datatype='string' name='[区分5]' role='dimension' type='nominal' />
      <column caption='区分6' datatype='string' name='[区分6]' role='dimension' type='nominal' />
      <column caption='区分7' datatype='string' name='[区分7]' role='dimension' type='nominal' />
      <column caption='金額' datatype='integer' name='[金額]' role='measure' type='quantitative' />
      <column caption='引用元' datatype='string' name='[引用元]' role='dimension' type='nominal' />
      <column caption='金額（億円）' datatype='real' name='[calc_okuyen]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([金額]) / 100000000' />
      </column>
      <column caption='歳入合計' datatype='real' name='[calc_sainyuu_total]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [区分1] = &quot;歳入予算&quot; AND [区分4] != &quot;&quot; THEN [金額] / 100000 END' />
      </column>
      <column caption='歳出合計' datatype='real' name='[calc_saisyutsu_total]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [区分1] = &quot;歳出款別（目的別）予算&quot; THEN [金額] / 100000 END' />
      </column>
      <column caption='&quot; &quot;' datatype='string' name='[calc_spacer]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='MIN(0.0)' datatype='real' name='[calc_min0]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0.0)' />
      </column>
      <column caption='MIN(1.0)' datatype='real' name='[calc_min1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1.0)' />
      </column>
      <column caption='年度略称' datatype='string' name='[calc_nendo_short]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [年度] = &quot;令和３年度&quot; THEN &quot;R3&quot;&#10;ELSEIF [年度] = &quot;令和４年度&quot; THEN &quot;R4&quot;&#10;ELSEIF [年度] = &quot;令和５年度&quot; THEN &quot;R5&quot;&#10;ELSEIF [年度] = &quot;令和６年度&quot; THEN &quot;R6&quot;&#10;ELSEIF [年度] = &quot;令和７年度&quot; THEN &quot;R7&quot;&#10;ELSE LEFT([年度], 4)&#10;END' />
      </column>
      <column caption='歳出億円' datatype='real' default-format='n#,##0' name='[calc_okuyen_saisyutsu]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [区分1] = &quot;歳出款別（目的別）予算&quot; THEN [金額] / 100000 END' />
      </column>
      <column caption='億円' datatype='real' default-format='n#,##0' name='[calc_okuyen_row]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[金額] / 100000' />
      </column>
      <column caption='歳入R7' datatype='real' default-format='n#,##0' name='[calc_sainyuu_r7]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [区分1] = &quot;歳入予算&quot; AND [区分4] != &quot;&quot; AND [年度] = &quot;令和７年度&quot; THEN [金額] / 100000 END' />
      </column>
      <column caption='歳入前年度比' datatype='real' default-format='n#,##0' name='[calc_sainyuu_yoy]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [区分1] = &quot;歳入予算&quot; AND [区分4] != &quot;&quot; THEN&#10;  IF [年度] = &quot;令和７年度&quot; THEN [金額] / 100000&#10;  ELSEIF [年度] = &quot;令和６年度&quot; THEN -[金額] / 100000&#10;  END&#10;END' />
      </column>
      <column caption='歳出R7' datatype='real' default-format='n#,##0' name='[calc_saisyutsu_r7]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [区分1] = &quot;歳出款別（目的別）予算&quot; AND [年度] = &quot;令和７年度&quot; THEN [金額] / 100000 END' />
      </column>
      <column caption='歳出前年度比' datatype='real' default-format='n#,##0' name='[calc_saisyutsu_yoy]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [区分1] = &quot;歳出款別（目的別）予算&quot; THEN&#10;  IF [年度] = &quot;令和７年度&quot; THEN [金額] / 100000&#10;  ELSEIF [年度] = &quot;令和６年度&quot; THEN -[金額] / 100000&#10;  END&#10;END' />
      </column>
