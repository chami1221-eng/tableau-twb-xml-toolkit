    <worksheet name='ヒートマップ_歳出推移'>
      <table>
        <view>
          <datasources>
            <datasource caption='予算データ（サンプル）' name='federated.ds_budget' />
          </datasources>
          <datasource-dependencies datasource='federated.ds_budget'>
            <column caption='区分1' datatype='string' name='[区分1]' role='dimension' type='nominal' />
            <column caption='区分3' datatype='string' name='[区分3]' role='dimension' type='nominal' />
            <column caption='区分5' datatype='string' name='[区分5]' role='dimension' type='nominal' />
            <column caption='年度略称' datatype='string' name='[calc_nendo_short]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [年度] = &quot;令和３年度&quot; THEN &quot;R3&quot;&#10;ELSEIF [年度] = &quot;令和４年度&quot; THEN &quot;R4&quot;&#10;ELSEIF [年度] = &quot;令和５年度&quot; THEN &quot;R5&quot;&#10;ELSEIF [年度] = &quot;令和６年度&quot; THEN &quot;R6&quot;&#10;ELSEIF [年度] = &quot;令和７年度&quot; THEN &quot;R7&quot;&#10;ELSE LEFT([年度], 4)&#10;END' />
            </column>
            <column caption='億円' datatype='real' default-format='n#,##0' name='[calc_okuyen_row]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[金額] / 100000' />
            </column>
            <column-instance column='[calc_nendo_short]' derivation='None' name='[none:calc_nendo_short:nk]' pivot='key' type='nominal' />
            <column-instance column='[区分1]' derivation='None' name='[none:区分1:nk]' pivot='key' type='nominal' />
            <column-instance column='[区分3]' derivation='None' name='[none:区分3:nk]' pivot='key' type='nominal' />
            <column-instance column='[区分5]' derivation='None' name='[none:区分5:nk]' pivot='key' type='nominal' />
            <column-instance column='[calc_okuyen_row]' derivation='Sum' name='[sum:calc_okuyen_row:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.ds_budget].[none:区分1:nk]'>
            <groupfilter function='member' level='[none:区分1:nk]' member='&quot;歳出性質別予算&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='filter-simple' />
          </filter>
          <filter class='categorical' column='[federated.ds_budget].[none:区分3:nk]'>
            <groupfilter function='member' level='[none:区分3:nk]' member='&quot;義務的経費&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='filter-simple' />
          </filter>
          <filter class='categorical' column='[federated.ds_budget].[none:区分5:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='filter-simple'>
              <groupfilter function='level-members' level='[none:区分5:nk]' />
              <groupfilter function='member' level='[none:区分5:nk]' member='&quot;&quot;' />
            </groupfilter>
          </filter>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.ds_budget].[sum:calc_okuyen_row:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'>&lt;[federated.ds_budget].[none:区分5:nk]&gt;</run>
                <run>&#10;</run>
                <run>&lt;[federated.ds_budget].[none:calc_nendo_short:nk]&gt;: &lt;[federated.ds_budget].[sum:calc_okuyen_row:qk]&gt; 億円</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.ds_budget].[none:区分5:nk]</rows>
        <cols>[federated.ds_budget].[none:calc_nendo_short:nk]</cols>
      </table>
      <simple-id uuid='{9B6D1FA4-D9E3-4BD2-B20C-B6CB5E76ABC4}' />
